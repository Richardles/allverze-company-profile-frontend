# ── Backend (server.mjs) ────────────────────────────────────────────
# All values are read from the environment at startup. SMTP_HOST, SMTP_USER,
# and SMTP_PASS are REQUIRED — the server refuses to start without them.

# SMTP relay for the contact form backend — Resend transactional email.
# Docs: https://resend.com — domain allverze.com is verified (SPF/DKIM live in Cloudflare).
# Endpoint: smtp.resend.com, port 587 (STARTTLS; 465 also supported).
# SMTP_USER is ALWAYS the literal `resend`; SMTP_PASS is a Resend API key
# (resend.com → API Keys), e.g. re_...
# (Previous provider — Gmail SMTP allverze.corporation@gmail.com + App Password —
#  is RETIRED: it hit Google's daily sending limit, 550-5.4.5.)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-api-key

# Valid From/sender address for all emails — MUST be on the Resend-verified
# domain (team@allverze.com). Public branding + envelope sender.
SMTP_FROM=team@allverze.com

# Where contact-form inquiries are delivered (Zoho Mail inbox).
# Production: team@allverze.com (Zoho receives via its own MX; Resend is send-only).
CONTACT_EMAIL=team@allverze.com

# Public-facing address shown in the confirmation email footer (branding).
# Production: team@allverze.com
PUBLIC_EMAIL=team@allverze.com

# WhatsApp number used in the confirmation email (no +, country code first).
WHATSAPP_NUMBER=6281283812336

# Allowed CORS origin for the API. Production: https://allverze.com
FRONTEND_URL=http://localhost:5173

# HTTP port for the API. Railway injects PORT automatically.
PORT=3001

# ── Frontend (VITE_* are inlined at build time) ─────────────────────
# API base URL the browser uses to reach the contact endpoint.
# Development: leave empty (Vite proxies /api to the server).
# Production: the Railway URL, e.g. https://your-app.up.railway.app
VITE_API_URL=

# WhatsApp number used across the site (widget, services, contact page).
VITE_WHATSAPP_NUMBER=6281283812336